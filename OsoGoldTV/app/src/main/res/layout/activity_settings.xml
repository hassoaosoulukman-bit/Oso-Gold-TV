<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layoutDirection="ltr">

    <com.osogold.tv.CosmicBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/GoldTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.osogold.tv.GoldIconButton
                android:id="@+id/btnPassword"
                android:layout_width="120dp"
                android:layout_height="136dp"
                app:gbIcon="@drawable/ic_lock"
                app:gbLabel="@string/settings_password" />

            <com.osogold.tv.GoldIconButton
                android:id="@+id/btnWelcome"
                android:layout_width="120dp"
                android:layout_height="136dp"
                app:gbIcon="@drawable/ic_video"
                app:gbLabel="@string/settings_welcome_video" />

            <com.osogold.tv.GoldIconButton
                android:id="@+id/btnSources"
                android:layout_width="120dp"
                android:layout_height="136dp"
                app:gbIcon="@drawable/ic_link"
                app:gbLabel="@string/settings_sources" />

            <com.osogold.tv.GoldIconButton
                android:id="@+id/btnSettingsBack"
                android:layout_width="120dp"
                android:layout_height="136dp"
                app:gbIcon="@drawable/ic_back"
                app:gbLabel="@string/back" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSettingsInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
