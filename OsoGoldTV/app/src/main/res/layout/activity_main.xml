<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layoutDirection="ltr">

    <com.osogold.tv.CosmicBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- LEFT: brand, quick search, favourites, tools -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="2"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBrand"
                style="@style/GoldTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:layoutDirection="rtl"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="#99D4AF37"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.osogold.tv.GoldIconButton
                        android:id="@+id/btnFav"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:gbIcon="@drawable/ic_star"
                        app:gbLabel="@string/favorites" />

                    <com.osogold.tv.GoldIconButton
                        android:id="@+id/btnSleep"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:gbIcon="@drawable/ic_timer"
                        app:gbLabel="@string/sleep_timer" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.osogold.tv.GoldIconButton
                        android:id="@+id/btnRefresh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:gbIcon="@drawable/ic_refresh"
                        app:gbLabel="@string/refresh" />

                    <com.osogold.tv.GoldIconButton
                        android:id="@+id/btnBack"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="invisible"
                        app:gbIcon="@drawable/ic_back"
                        app:gbLabel="@string/back" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/now_playing_none"
                android:textColor="@color/gold_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CENTER: cosmic orbit + glowing circular player -->
        <com.osogold.tv.OrbitLayout
            android:id="@+id/orbit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">

            <FrameLayout
                android:id="@+id/playerFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="zoom"
                    app:show_buffering="when_playing"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <TextView
                    android:id="@+id/tvRec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="14dp"
                    android:text="@string/rec_label"
                    android:textColor="@color/record_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnRecord"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_record"
                        android:contentDescription="@string/rec_label"
                        android:padding="7dp"
                        android:src="@drawable/ic_record" />

                    <ImageView
                        android:id="@+id/btnFullscreen"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_control_dark"
                        android:contentDescription="@string/app_name"
                        android:padding="7dp"
                        android:src="@drawable/ic_fullscreen" />
                </LinearLayout>
            </FrameLayout>
        </com.osogold.tv.OrbitLayout>

        <!-- RIGHT: list (channels / countries / favourites) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvListTitle"
                style="@style/GoldTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:gravity="start"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/sec_live"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:gravity="start"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:text="@string/loading"
                android:textColor="@color/gold"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- FULLSCREEN overlay -->
    <FrameLayout
        android:id="@+id/fullscreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerViewFull"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <ImageView
            android:id="@+id/btnExitFull"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_control_dark"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_fullscreen_exit" />
    </FrameLayout>

    <!-- Volume / brightness indicator -->
    <TextView
        android:id="@+id/tvIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_skip"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/gold_light"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
