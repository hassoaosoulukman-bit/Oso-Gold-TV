<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layoutDirection="ltr">

    <!-- Shown only when no welcome video is available: animated royal intro (30 seconds). -->
    <FrameLayout
        android:id="@+id/fallbackRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.osogold.tv.CosmicBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.osogold.tv.RoyalLogoView
            android:id="@+id/welcomeLogo"
            android:layout_width="360dp"
            android:layout_height="340dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/welcomePlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_skip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/skip"
        android:textColor="@color/gold_light"
        android:textSize="16sp"
        android:textStyle="bold" />

</FrameLayout>
