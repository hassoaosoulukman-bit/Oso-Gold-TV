<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OsoGold" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorHint">#99D4AF37</item>
    </style>

    <style name="GoldDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/gold</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="textColorAlertDialogListItem">@color/text_main</item>
        <item name="colorAccent">@color/gold_light</item>
        <item name="android:textColorHint">#99D4AF37</item>
    </style>

    <style name="GoldTitle">
        <item name="android:textColor">@color/gold_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#99D4AF37</item>
        <item name="android:shadowRadius">8</item>
    </style>

</resources>
